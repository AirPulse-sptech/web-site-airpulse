# Copie este arquivo para .env na pasta do projeto e preencha os valores.
# O deploy.sh envia apenas as variáveis do bloco abaixo no arquivo temporário deploy.env.

# Enviadas à EC2 pelo deploy.sh

# Usuário e senha do MySQL usados pelo Node. Em um volume existente,
# use as credenciais já cadastradas no banco. Senhas com caracteres especiais
# podem ser escritas entre aspas simples no .env.
DB_USER=airpulse
DB_PASSWORD=urubu100

# Preencha para habilitar a análise de relatórios com Gemini.
GEMINI_API_KEY=

# Integração somente leitura com Jira (detalhe da placa).
# Enviadas à EC2 pelo deploy.sh (para o Node) e pelo deployjava.sh (para o Java).
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_ALERT_PROJECT_KEY=
# Tipo da issue criada pelo script Java. Default: Task.
JIRA_ALERT_ISSUE_TYPE=Task

# Tag da imagem Node (mateusloualmeida/airpulse_deploy) usada pelo deploy.sh.
# Default: airpulse. Fixe uma tag versionada (ex.: v20261127-0300-abc1234)
# publicada pelo build-and-push.sh para rollback.
NODE_IMAGE=gabrielfarina/airpulse_deploy
NODE_IMAGE_TAG=airpulse

# Tag da imagem Java (mateusloualmeida/airpulse-alertas) usada pelo compose.
# Default: latest. Fixe uma tag (ex.: v20261127-0300-abc1234) para rollback.
JAVA_IMAGE_TAG=latest

# Bucket e região onde a Lambda publica os arquivos Gold.
# Informe apenas o nome do bucket, sem s3:// e sem o prefixo.
aws_s3_bucket=airpulse-s3
aws_region=us-east-1
aws_s3_alertas_prefix=03-gold/

# O Node usa a cadeia padrão de credenciais AWS, como a role da EC2.
# O deploy.sh envia os dados do bucket acima. Configure o acesso AWS na EC2.

# Usadas ao rodar o Node diretamente na sua máquina.
# No deploy, o Compose define produção, o host do container MySQL e as portas.
AMBIENTE_PROCESSO=producao
DB_HOST=localhost
DB_DATABASE=airpulse
DB_PORT=3306
APP_PORT=3333
APP_HOST=0.0.0.0

# Modelo padrão do Gemini na imagem. O deploy.sh não repassa este valor.
GEMINI_MODEL=gemini-3.5-flash-lite
